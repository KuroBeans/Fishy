/////////////////////////start scan //////////////////////////
Scan = function()
    print(Red + "<size=75%>Only Works LOCALLY... REMOTE is WIP</size>")
    bIP = user_input("lanIP for BOUNCE/PASS Change? ||> ")

    if g.mx == null then
        print("Metaxploit not loaded — run Load_Lib first")
        return
    end if

    libPath = params[0]
    metalib = g.mx.load(libPath)
    if metalib == null then
        print("Lib not found: " + libPath)
        return
    end if

    memlist = g.mx.scan(metalib)
    if memlist == null or memlist.len == 0 then
        print("No scan results")
        return
    end if

    print("<color=#007413FF>|- Scan entries: " + memlist.len + "</color>")
    f.scanlist = []
    i = 1

    for mem in memlist
        scanResults = g.mx.scan_address(metalib, mem).split("Unsafe check: ")
        for result in scanResults
            if result == scanResults[0] then continue
            value = result.trim()
            print(char(10) + "<color=#FFE5B4>[" + i + "] " + mem + "  " + value + "</color>")
            obj = metalib.overflow(mem, value, bIP)
            if typeof(obj) == "shell" or typeof(obj) == "computer" then
                print("Object obtainable: <color=#D700FF>" + obj + "</color>  (" + typeof(obj) + ")")
                f.scanlist.push([mem, value, obj])
            else if typeof(obj) == "file" then
                print("Object obtainable: <color=#FF13F0>" + obj + " --> " + obj.name + "</color>")
                if obj then f.shell.push([mem, value, obj])
            end if
            i = i + 1
        end for
    end for

    if f.scanlist.len == 0 then
        print("No objects obtained from overflow attempts")
    else
        print("<color=#007413FF>|- " + f.shell.len + " object(s) stored in scanlist</color>")
    end if
end function
////////////////////////////end scan///////////////////////////
///////////////////////////start corlog ////////////////////////
Cor_log = function()
    computer = g.actshell
    if g.actshell == null then
        computer = get_shell.host_computer
    end if

    // Create the file in /root
    rootDir = computer.File("/root")
    if rootDir == null or not rootDir.has_permission("w") then
        print("cannot create file in /root (directory not found or no permission)")
        return
    end if
    output = computer.touch("/root", "system.log")
    if output and output != 1 then
        print("create_log: failed to create system.log in /root: " + output)
        return
    end if
    print("Created system.log in /root")

    // Move to /var
    varDir = computer.File("/var")
    if varDir == null or not varDir.has_permission("w") then
        print("create_log: cannot move to /var (directory not found or no permission)")
        return
    end if
    file = computer.File("/root/system.log")
    if file == null then
        print("create_log: system.log not found after creation")
        return
    end if
    output = file.move("/var", "system.log")
    if output and output != 1 then
        print("create_log: failed to move system.log to /var: " + output)
    else
		print(Red+"Corrupting logs...")
        print(cor.green+"log corrupted")
    end if
end function
///////////////////////end corlog ///////////////////////////////
