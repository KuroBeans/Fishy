extract_label = function(text)
    if text == null then return null end if
    bs = text.indexOf("<b>")
    be = text.indexOf("</b>")
    if bs == null or be == null or be <= bs then return null end if
    return text[bs + 3 : be]
end function

///////////////////// Start Nmap ////////////////////
nmap = function
// ============================================
//   NMAP - Enhanced Port Scanner
//   GreyScript | Grey Hack Terminal
//   v1.2
// ============================================

// ── Colors ───────────────────────────────────
Cor = {}
cor = new Cor
cor.moon   = "<color=#F6F1D5>"
cor.red    = "<color=#780606>"
cor.green  = "<color=#26E048FF>"
cor.silver = "<color=#C0C0C0>"
cor.orang  = "<color=#FF8701>"
cor.white  = "<color=#FFFFFF>"
cor.purple = "<color=#D700FF>"
cor.cop    = "<color=#B87333>"
cap = "</color>"

// ── Common ports ─────────────────────────────
COMMON_PORTS = [21, 22, 25, 80, 1222, 1542, 3306, 3307]

// ── Helpers ──────────────────────────────────

divider = function()
    print(cor.silver + "  +=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+" + cap)
end function

pad_right = function(s, width)
    s = "" + s
    while s.len < width
        s = s + " "
    end while
    return s
end function

// ── Banner ───────────────────────────────────

banner = function()
    print("")
    print(cor.green + "  +=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+" + cap)
    print(cor.green + "  |                                           |" + cap)
    print(cor.green + "  |    NMAP  -  Enhanced Network Scanner      |" + cap)
    print(cor.green + "  |                                           |" + cap)
    print(cor.green + "  +=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+=+" + cap)
    print("")
    print(cor.silver + "  FishScript  |  v1.2" + cap)
    divider()
end function

// ── Usage ────────────────────────────────────

usage = function()
    print(cor.white  + "  Usage:" + cap)
    print(cor.moon   + "    nmap <ip>           " + cap + cor.silver + "— standard scan" + cap)
    print(cor.moon   + "    nmap <ip> -o        " + cap + cor.silver + "— open ports only (skip empty hosts)" + cap)
    print(cor.moon   + "    nmap <ip> -w        " + cap + cor.silver + "— whois lookup + scan" + cap)
    print(cor.moon   + "    nmap <ip> -a        " + cap + cor.silver + "— all: full scan + whois" + cap)
    print(cor.moon   + "    nmap <ip> -v        " + cap + cor.silver + "— verbose (show LAN IPs with no open ports)" + cap)
    print(cor.moon   + "    nmap --help         " + cap + cor.silver + "— show this menu" + cap)
    print("")
    print(cor.silver + "  Flags can be combined: " + cap + cor.moon + "nmap <ip> -o -w" + cap)
    divider()
end function

// ── Service Name Lookup ──────────────────────

service_name = function(port_num)
    services = { "21":   "ftp","22":   "ssh", "25":   "smtp", "80":   "http","1222": "rshell","1542": "repository", "3306": "mysql","3307": "mysql-alt"}
          

    key = "" + port_num
    if services.hasIndex(key) then return services[key]
    return "unknown"
end function

// ── Scan Device ──────────────────────────────

scan_device = function(router, ip, flag_open_only, flag_verbose)
    ports = router.device_ports(ip)
    if ports == null then ports = []

    // Build open port lookup map
    open_map = {}
    for p in ports
        open_map["" + p.port_number] = p
    end for

    // Host header
    print("")
    print(cor.white + "  Host: " + cap + cor.orang + ip + cap)

    // No open ports — always show, even with -o
    if ports.len == 0 then
        print(cor.orang + "  [!] No open ports." + cap)
        return
    end if

    // -o: skip hosts with no open ports from full detail view
    if flag_open_only and ports.len == 0 then return

    print(cor.silver + "  " + ports.len + " open port(s)" + cap)
    print("")

    // Column headers
    print(cor.purple +
          pad_right("  PORT", 10) +
          pad_right("STATE", 10) +
          pad_right("SERVICE", 14) +
          "VERSION" + cap)
    print(cor.silver + "  ----------------------------------------" + cap)

    if flag_verbose then
        // Check COMMON_PORTS first, print only open ones
        shown = {}
        for portNum in COMMON_PORTS
            key = "" + portNum
            svc = service_name(portNum)
            if open_map.hasIndex(key) then
                p = open_map[key]
                info = router.port_info(p)
                ver = ""
                if info != null then ver = info
                line = pad_right("  " + portNum + "/tcp", 10) +
                       pad_right("open", 10) +
                       pad_right(svc, 14)
                print(cor.green + line + cap + cor.cop + ver + cap)
            end if
            shown[key] = true
        end for
        // Any open ports not in COMMON_PORTS
        for p in ports
            key = "" + p.port_number
            if not shown.hasIndex(key) then
                svc = service_name(p.port_number)
                info = router.port_info(p)
                ver = ""
                if info != null then ver = info
                line = pad_right("  " + p.port_number + "/tcp", 10) +
                       pad_right("open", 10) +
                       pad_right(svc, 14)
                print(cor.green + line + cap + cor.cop + ver + cap)
            end if
        end for
    else
        // Normal: open ports only
        for p in ports
            svc = service_name(p.port_number)
            info = router.port_info(p)
            ver = ""
            if info != null then ver = info
            line = pad_right("  " + p.port_number + "/tcp", 10) +
                   pad_right("open", 10) +
                   pad_right(svc, 14)
            print(cor.green + line + cap + cor.cop + ver + cap)
        end for
    end if
end function

// ── Entry Point ──────────────────────────────

if params.len == 0 then
    banner()
    usage()
    return
end if

target       = ""
flag_open    = false
flag_whois   = false
flag_all     = false
flag_verbose = false

for p in params
    if p == "--help" or p == "-h" then
        banner()
        usage()
        return
    else if p == "-o" then
        flag_open = true
    else if p == "-w" then
        flag_whois = true
    else if p == "-a" then
        flag_all   = true
        flag_whois = true
    else if p == "-v" then
        flag_verbose = true
    else if p[0] != "-" then
        target = p
    end if
end for

if target == "" then
    banner()
    print(cor.red + "  Error: no target IP provided." + cap)
    print("")
    usage()
    return
end if

if not is_valid_ip(target) then
    banner()
    print(cor.red + "  Error: '" + target + "' is not a valid IP address." + cap)
    print("")
    usage()
    return
end if

// ── Run Scan ─────────────────────────────────

clear_screen
banner()

print(cor.white + "  Target : " + cap + cor.orang + target + cap)

flags_str = ""
if flag_open    then flags_str = flags_str + "-o "
if flag_whois   then flags_str = flags_str + "-w "
if flag_all     then flags_str = flags_str + "-a "
if flag_verbose then flags_str = flags_str + "-v "
if flags_str == "" then flags_str = "none"
print(cor.silver + "  Flags  : " + cap + cor.moon + flags_str + cap)
divider()

// Whois block
if flag_whois or flag_all then
    print(cor.purple + "  [ WHOIS ]" + cap)
    print("")
    host_info = whois(target)
    if host_info then
        print(cor.moon + "  " + host_info + cap)
    else
        print(cor.silver + "  No whois data found." + cap)
    end if
    divider()
end if

// Get router
router = get_router(target)

if router == null then
    print(cor.red + "  Could not reach router at " + target + cap)
    print(cor.silver + "  Host may be offline or unreachable." + cap)
    print("")
    return
end if

print(cor.white + "  Router kernel : " + cap + cor.cop + router.kernel_version + cap)
divider()

// Get LAN devices
devices = router.devices_lan_ip

if devices == null or devices.len == 0 then
    print(cor.silver + "  No devices discovered on network." + cap)
    print("")
    return
end if

print(cor.white + "  Discovered " + cap + cor.orang + devices.len + cap + cor.white + " device(s)" + cap)

// Find exposed hosts
exposed_hosts = []
for ip in devices
    ports = router.device_ports(ip)
    if ports == null or ports.len == 0 then
        exposed_hosts.push(ip)
    end if
end for

if exposed_hosts.len > 0 then
    print("")
    print(cor.orang + "  [!] Hosts with no open ports (" + exposed_hosts.len + "):" + cap)
    for h in exposed_hosts
        print(cor.orang + "      - " + h + cap)
    end for
end if
divider()

// Scan each device
total_open = 0
for ip in devices
    ports = router.device_ports(ip)
    if ports != null then total_open = total_open + ports.len
    scan_device(router, ip, flag_open, flag_verbose)
    divider()
end for

// Summary
print("")
print(cor.white  + "  Scan complete." + cap)
print(cor.green  + "  Open    : " + total_open + cap)
print(cor.silver + "  Devices : " + devices.len + cap)
if exposed_hosts.len > 0 then
    print(cor.orang + "  Exposed : " + exposed_hosts.len + cap)
end if
print("")
end function
/////////////////////// end Nmap ////////////////////////
/////////////////////// start es ////////////////////////
exploit =function
if params[0] == null or params.len < 2 then
	print("Usage||> es [ip] [port]")
	return
end if

f.shell = []
f.actmem = null
f.actval = null
f.actindex = null
f.actshells = null
f.actshells = null
f.libdump
g.ip = params[0]
g.port = params[1].to_int
g.bip = user_input(cor.green+"Lan or Pw Change? ||> ")
f.net = g.mx.net_use(g.ip, g.port)
if f.net == null then
	print(Red + "Netsession Not Accquired....")
	return
end if

f.libdump = f.net.dump_lib
if f.libdump == null then 
	user_input(Red + "Unable to Dump Lib")
	return
end if

memlist = g.mx.scan(f.libdump)
if memlist == null or memlist.len == 0 then
	print(Red + "No Scan Results...")
	return
end if
user_input("<color=#007413FF>debug||-Scan entries: " + memlist.len + "</color>")
i = 1
for mem in memlist
	scanresults = g.mx.scan_address(f.libdump, mem).split("Unsafe check: ")
	for results in scanresults
		if results == scanresults[0] then continue
		val = results[results.indexOf("<b>")+3:results.indexOf("</b>")]
		print(char(10) + "<color=#FFE5B4>" + "<b>"+mem + " " + val)
		obj = f.libdump.overflow(mem, val, g.bip)
		if typeof (obj) == "shell" then print("<b>object obtainable: "+cor.green+obj+char(10))
		if typeof(obj) == "computer" then print("<b>object obtainable: "+"<color=#FF8701>"+obj+char(10))
		if typeof(obj) == "file" then print("<b>object obtainable: "+"<color=#D700FF>"+obj+ " ==>" + obj.name+ char(10))
		i = i +1
		if obj then 
			f.shell.push([mem, val, obj])
		end if
	end for
end for
print("<color=#007413FF>|-Available targets: " + f.shell.len + "</color>")
print("<color=#FF00E2FF>[i] New target ready.</color> " + g.ip + " || " + g.port)
end function
//////////////////////// end of es ////////////////////
//////////////////////// Start of Targets////////////////////
targ = function
if f.shell == null or f.shell.len == 0 then
	print("<color=#ff0000>No Available Targets")
	return
end if
print(cor.green + "<size=125%><----- Available targets -----></size></color>")
idx = 0

for entry in f.shell
