			f.lan = g.actshell.local_ip
			



        print("[i] <color=#FF00E2FF><size=125%>Selected|> </size></color> <color=#55AAFF>" + activeObj + " | " + f.actmem + "</color> | <color=#FFA100FF>" + f.actval + " | " +  "<color=#FF00E2FF>" + f.ip + " | " + f.lan + " | "  + "</color>")
		else
        print("[!] Invalid selection")
    end if
end function
//////////////////////// end of targets /////////////////////
//////////////////////// start Mail_dump ///////////////////////
mail_dump = function
    comp = g.actshell.host_computer
    if comp == null then
        print(Red + "No Active Obj...")
        return
    end if

    if g.cx == null then
        print(Red + "CRYPTO NULL")
        return
    end if

    home = comp.File("/home")
    folders = home.get_folders

    for f in folders
        t = f.name
        p = "/home/" + t + "/Config"
        mails = comp.File(p)
        if mails == null then continue

        cont = mails.get_files
        if cont == null or cont.len == 0 then continue

        // ── Loop over every file in the Config folder ──
        for file in cont
            content = file.get_content
            if content == null or content == "" then continue

            lines = split(content, "\n")

            for line in lines
                if line == "" then continue

                parts = split(line, ":")
                if parts.len < 2 then
                    print("Skipping invalid line: " + line)
                    continue
                end if

                user = parts[0]
                encpass = parts[1]

                if encpass == null or encpass == "" then
                    print("Bad hash in file: " + file.name)
                    continue
                end if

                pw = g.cx.decipher(encpass)

                if pw == null then
                    print("Failed decrypt: " + encpass)
                    continue
                end if

                if user == "root" then
                    col = Red
                else
                    col = cor.Random
                end if

                print(format_columns(col + "User||> " + user + cor.Random + " | Pass||: " + pw))
            end for
        end for
    end for
end function
//////////////////// end of Mail_Dump ///////////////////
//////////////////// start of Dump ////////////////////
dump = function 
if not g.actshell then
    print("[i]Computer/Shell not available")
    return
end if
if typeof(g.actshell) == "computer" then
    comp = g.actshell
else
    comp = g.actshell.host_computer
end if
passwdFile = comp.File("/etc/passwd")
if not passwdFile then
    print("Permission Denied")
    return
end if

if passwdFile != null then
    content = passwdFile.get_content
end if
if not content then
    print("/etc/passwd Not Found")
    return
end if

if content != null then
    print("--- /etc/passwd ---")
    print(char(10) + content)
end if			
if g.cx != null then
    print("--- Deciphered ---")
end if
for line in content.split("\n")
    if line.len > 0 then
        parts = line.split(":")
        username = parts[0]
        hash = parts[1]
        
        if hash != "" and hash != "x" and hash != "*" then
            pw = g.cx.decipher(hash)
            col = "<color=#FFAA00FF>"
            if username == "root" then col = "<color=#FF0000FF>" end if
            print(col + "User: " + username + " | Pass: " + pw)
        else
            print("User: " + username + " | Pass: <none>")
        end if
end if
    end for
end function
/////////////////// start ls ////////////////////
ls = function()
    ValidateInput = function(input)
        return (input == "-la" or input == "-l" or input == "-a")
    end function 

    ParamsValid = function(params)
        if params.len > 3 then return false 
        for p in params                               
            if p.indexOf("-") != null and not ValidateInput(p) then return false
        end for                                     
        return true                                
    end function
    
    if not ParamsValid(params) then
        print(command_info("ls_usage"))
        return
    end if
    
    
computer = g.actshell.host_computer
if typeof(g.actshell) == "computer" then
	computer = g.actshell
end if



    
    folderPath = current_path
    if params and params[params.len - 1].indexOf("-") == null then
        folderPath = get_abs_path(params[params.len - 1])
    end if
    
    folder = computer.File(folderPath)
    if folder == null then
        print("ls: No such file or directory")
        return
    end if
    
    if not folder.has_permission("r") then
        print("ls: permission denied")
        return
    end if
    
    showHide = 0
    if params and params[0].indexOf("a") != null then
        showHide = 1
    end if

    showDetails = 0
    if params and params[0].indexOf("l") != null then
        showDetails = 1
    end if

    subFiles = folder.get_folders + folder.get_files
    output = ""
    for subFile in subFiles
        nameFile = subFile.name
        permission = subFile.permissions
        owner = subFile.owner
        size = subFile.size
        group = subFile.group

        if showHide or nameFile.indexOf(".") != 0 then
            if output.len > 0 then 
                output = output + "\n"
            end if
            if showDetails then
                output = output + permission + " " + owner + " " + group + " " + size + " 00:00 " + nameFile
                if subFile.is_symlink then output = output + "-->" + subFile.path(true)
            else
                output = output + nameFile
            end if
        end if
    end for
    
    print(format_columns(output))
end function
/////////////////////// end of LS ////////////////////////
/////////////////////// start of rm //////////////////////
rm = function()

if params.len < 1 or params.len > 2 or params[0] == "-h" or params[0] == "--help" then return (command_info("rm_usage"))
comp =  g.actshell

pathFile = get_abs_path(params[0])
isRecursive = 0
if params[0] == "-r" then
    if params.len == 1 then return (command_info("rm_usage"))
    isRecursive = 1
    pathFile = params[1]
end if

file = comp.File(pathFile)

if file == null then return("rm: file not found: " + pathFile)
if not file.has_permission("w") then return ("rm: permission denied")

if file.is_folder == 1 and isRecursive == 0 and file.is_symlink == 0 then
    print("rm: " + file.name + " is a directory")
else
    output = file.delete
    if output.len != 0 then 
	print(Red+"File Removed")
end if
end function
//////////////////////// end of rm /////////////////////
//////////////////////// start of touch ///////////////////////
Touch = function()
    if params.len != 1 or params[0] == "-h" or params[0] == "--help" then
        print(command_info("touch_usage"))
        return
    end if

    pathFile = get_abs_path(params[0])
    pathParent = parent_path(pathFile)
    computer = g.actshell
    if g.actshell == null then
        computer = get_shell.host_computer

	else
	if typeof(g.actshell) == "computer" then
	computer = g.actshell

    end if

    if pathParent == pathFile then
        pathParent = current_path
    end if

    parent = computer.File(pathParent)

    if not parent then
        print("touch: " + pathParent + " not found")
        return
    end if
    if not parent.has_permission("w") then
        print("touch: permission denied")
        return
    end if

    arrayPath = pathFile.split("/")
    output = computer.touch(parent.path, arrayPath[arrayPath.len - 1])
    if output and output != 1 then print(output)
end function
/////////////////// end of touch ////////////////////
/////////////////// start of MV /////////////////////
mv = function()
    Basename = function(p)
        if p == "/" then return "/"
        if p.len > 1 and p[p.len-1:p.len] == "/" then
            p = p[0:p.len-1] 
        end if
        parts = p.split("/")
        return parts[parts.len-1]
    end function

    if params.len != 2 then
        print(command_info("mv_usage"))
        return
    end if

    origFile = get_abs_path(params[0])
    destFolder = get_abs_path(params[1])

    computer = g.actshell
    if g.actshell == null then
        computer = get_shell.host_computer
    end if

    file = computer.File(origFile)
    if file == null then
        print("mv: can't find " + origFile)
        return
    end if

    if not file.has_permission("w") then
        print("mv: permission denied")
        return
    end if

    newName = ""
    folder = computer.File(destFolder)
    if folder == null then
        // Check if the user wants to rename the file.
        pathParent = parent_path(destFolder)
                
        if pathParent == destFolder then            
            newName = destFolder
            destFolder = file.parent.path        
            output = file.move(destFolder, newName)
            if output and output != 1 then print(output)
            return
        else
            folder = computer.File(pathParent)
            newName = Basename(destFolder)
            if folder == null then                
                print("mv: can't move file. " + destFolder + " doesn't exist.")
                return
            end if            
        end if
    end if

    if folder != null then
        // Check if trying to move the file onto itself. Ignore.
        if folder.parent != null and file.parent.path == folder.parent.path and file.name == folder.name then return

        finalDest = folder.path
            
        if newName.len == 0 then
            newName = file.name
        end if

        if not folder.is_folder then            
            finalDest = file.parent.path
            newName = folder.name
        end if
        
        fileParentPath = "none"
        folderParentPath = "none"
        if file.parent != null then fileParentPath = file.parent.path
        if folder.parent != null then folderParentPath = folder.parent.path

        if fileParentPath == folderParentPath and finalDest == folderParentPath and newName != file.name then
            output = file.rename(newName)
            if output and output != 1 then print(output)
        else
            output = file.move(finalDest, newName)
            if output and output != 1 then print(output)
        end if
    end if
end function
///////////////////////// end of mv ///////////////////////
