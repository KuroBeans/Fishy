Load_Lib = function(path)
    pathList = path.split("/")
    lib = pathList[-1]
    if lib == "metaxploit.so" then
        meta = include_lib(path)
        if not meta then
            print("<color=yellow>"+"Error: loadlib: unable to find metaxploit.so file at: "+path)
            return
        end if
        gco.meta = meta
        print ("<color=green>"+"gco.meta has been set")
        return
    end if
    if lib == "crypto.so" then
        crypto = include_lib(path)
        if not crypto then
            print("<color=yellow>"+"Error: loadlib: unable to find crypto.so file at: "+path)
            return
        end if
        gco.crypto = crypto
        print("<color=green>"+"gco.crypto has been set")
        return
    end if
    print("<color=yellow>" + "unable to locate lib file at: "+path)
    return
end function


